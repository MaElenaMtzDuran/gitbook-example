{
  "title": "Repositorio de ejemplo GitBook",
  "description": "Estructura estandarizada de ejemplo para proyectos GitBook, con generación automática de PDF y EPUB y despliegue continuo vía GitHub.",
  "author": "Ma. Elena Martínez Durán",
  "language": "es",
  "gitbook": "3.2.3",
  "root": "./",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "plugins": [
    "theme-default",
    "search-pro",
    "sharing",
    "font-settings",
    "-search"
  ],
  "pluginsConfig": {
    "sharing": {
      "all": false,
      "github": true
    },
    "fontsettings": {
      "theme": "white",
      "family": "sans",
      "size": 2
    }
  },
  "pdf": {
    "pageNumbers": true,
    "fontSize": 12,
    "fontFamily": "Arial",
    "paperSize": "a4",
    "chapterMark": "pagebreak",
    "margin": {
      "right": 62,
      "left": 62,
      "top": 56,
      "bottom": 56
    }
  },
  "epub": {
    "css": []
  },
  "links": {
    "sidebar": {
      "Repositorio en GitHub": "https://github.com/tu-usuario/gitbook-example"
    }
  }
}
